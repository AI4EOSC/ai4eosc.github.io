---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CtaFinal from '../../components/ui/CtaFinal.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { getCollection } from 'astro:content';
import { eventTime } from '../../lib/eventTime';
import '../../styles/story-card.css';

const stories = await getCollection('stories');
const sorted = stories.toSorted((a, b) => +b.data.date - +a.data.date);

const types = ['All', ...[...new Set(sorted.map(s => s.data.type))].sort()];

const totalCount = sorted.length;
const newsCount  = sorted.filter(s => s.data.type === 'News').length;
const videoCount = sorted.filter(s => s.data.type === 'Video').length;
---

<Layout title="Stories — AI4EOSC Initiative" ogImage="/og/stories.png">
  <PageHero
    theme="teal"
    breadcrumb="Stories"
    title="Stories from the ecosystem"
    description="Case studies, research highlights and updates from the scientific communities, projects and developers building on AI4EOSC."
  >
    <div class="hero-stats">
      <div class="hstat"><span class="hstat-val">{totalCount}<em>+</em></span><span class="hstat-lbl">Total stories</span></div>
      <div class="hstat"><span class="hstat-val">{newsCount}<em>+</em></span><span class="hstat-lbl">News articles</span></div>
      <div class="hstat"><span class="hstat-val">{videoCount}<em>+</em></span><span class="hstat-lbl">Videos</span></div>
    </div>
  </PageHero>

  <div id="upcoming-events" hidden>
    <div class="section-label"><div class="container">Upcoming events</div></div>
    <div class="container">
      <div class="section-card">
        <SectionHeader
          title="What's next"
          subtitle="Webinars and events from across the AI4EOSC ecosystem."
        />
        <div class="grid" id="upcoming-grid"></div>
      </div>
    </div>
  </div>

  <div class="section-label"><div class="container">All stories</div></div>
  <div class="container">
    <div class="section-card">
      <SectionHeader
        title="From the initiative"
        subtitle="News, case studies and research highlights from across the AI4EOSC ecosystem."
      />

      <div x-data={`{
        filter: 'All',
        page: 1,
        perPage: 9,
        items: [],
        get filtered() {
          return this.items.filter(el => this.filter === 'All' || el.dataset.type === this.filter);
        },
        get totalPages() {
          return Math.max(1, Math.ceil(this.filtered.length / this.perPage));
        },
        get pages() {
          return Array.from({ length: this.totalPages }, (_, i) => i + 1);
        },
        init() {
          const today = new Date().toISOString().slice(0, 10);
          this.items = [...this.$el.querySelectorAll('.item')].filter(el => !(el.dataset.eventDate >= today));
          this.$watch('filter', () => { this.page = 1; this.$nextTick(() => this.render()); });
          this.$nextTick(() => this.render());
        },
        setFilter(f) { this.filter = f; },
        goTo(p) {
          this.page = p;
          this.$el.closest('.section-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
          this.$nextTick(() => this.render());
        },
        render() {
          const start = (this.page - 1) * this.perPage;
          const visible = this.filtered.slice(start, start + this.perPage);
          const visibleSet = new Set(visible);
          this.items.forEach(el => {
            el.style.display = visibleSet.has(el) ? '' : 'none';
            el.classList.remove('is-col-sep', 'is-col-end', 'is-row-sep');
          });
          visible.forEach((el, i) => {
            el.classList.toggle('is-col-sep', i % 3 !== 0);
            el.classList.toggle('is-col-end', i % 3 === 2);
            el.classList.toggle('is-row-sep', i >= 3);
          });
        }
      }`}>

        <!-- Filters -->
        <div class="filter-columns">
          <div class="filter-col">
            <span class="filter-col-label">Content type</span>
            <div class="filters">
              {types.map(t => (
                <button
                  class="filter-btn"
                  x-bind:class={`{ 'is-active': filter === '${t}' }`}
                  x-on:click={`setFilter('${t}')`}
                  type="button"
                >
                  {t === 'Event' ? 'Past events' : t}
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Grid -->
        <div class="grid" id="all-grid">
          {sorted.map((story) => (
            <a
              href={story.data.externalUrl ?? `/stories/${story.id}`}
              class="item story-card has-image"
              data-type={story.data.type}
              data-event-date={story.data.type === 'Event' ? story.data.date.toISOString().slice(0, 10) : undefined}
              data-event-start={story.data.eventStart?.toISOString()}
              data-event-end={story.data.eventEnd?.toISOString()}
              style="display:none"
              {...(story.data.externalUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <div class="image">
                {story.data.image
                  ? <img src={story.data.image} alt="" loading="lazy" />
                  : <div class="placeholder" aria-hidden="true">
                      <svg class="placeholder-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M7 8h10M7 12h10M7 16h6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                      </svg>
                    </div>
                }
              </div>
              <div class="body">
                <div class="meta">
                  <span class="tag">{story.data.type}</span>
                  <span class="dot" aria-hidden="true"></span>
                  <span class="date">
                    {story.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </span>
                  {eventTime(story.data) && (<>
                    <span class="dot" aria-hidden="true"></span>
                    <span class="date">{eventTime(story.data)}</span>
                  </>)}
                  {story.data.type === 'Event' && <span class="story-status" hidden></span>}
                </div>
                <h4>{story.data.title}</h4>
                <p>{story.data.excerpt}</p>
                <span class="read-link" data-event-action={story.data.type === 'Event' ? '' : undefined}>{story.data.externalUrl ? 'View on external site' : 'Read story'}</span>
              </div>
            </a>
          ))}
        </div>

        <!-- Pagination -->
        <div class="pagination" x-show="totalPages > 1" x-cloak>
          <button
            class="page-btn"
            x-on:click="goTo(page - 1)"
            x-bind:disabled="page === 1"
            aria-label="Previous page"
          >←</button>
          <template x-for="p in pages" :key="p">
            <button
              class="page-btn"
              x-bind:class="{ 'is-active': p === page }"
              x-on:click="goTo(p)"
              x-text="p"
            ></button>
          </template>
          <button
            class="page-btn"
            x-on:click="goTo(page + 1)"
            x-bind:disabled="page === totalPages"
            aria-label="Next page"
          >→</button>
        </div>

      </div>
    </div>
  </div>

  <CtaFinal
    theme="teal"
    title="Share your story"
    description="Are you using AI4EOSC in your research? We'd love to feature your work and help others discover what's possible on the platform."
    button={{ label: 'Get in touch', href: '/support/contact' }}
  />
</Layout>

<script>
  import { placeUpcoming } from '../../lib/eventStatus';

  document.addEventListener('astro:page-load', () => placeUpcoming(document.getElementById('all-grid'), {
    block: document.getElementById('upcoming-events'),
    grid: document.getElementById('upcoming-grid'),
    remove: false,
  }));
</script>


<style>
  /* ── Grid ───────────────────────────────────────────── */
  .grid {
    display: grid;
    /* middle track is 28px wider so its text, with 56px of padding, matches the side columns (28px) */
    grid-template-columns: calc((100% - 1.6471rem) / 3) calc((100% + 3.2941rem) / 3) calc((100% - 1.6471rem) / 3);
    gap: 0;
    margin-top: 1.1765rem;
    container-type: inline-size;
  }

  /* ── Image ──────────────────────────────────────────── */
  .image {
    width: 100%;
    height: calc((100cqw - 1.6471rem) / 9); /* 3:1 of a side column, so all images share one height */
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--card-border);
    background: #1d3238;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(0, 135, 146, 0.22) 1px, transparent 1px);
    background-size: 1.1765rem 1.1765rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Separators (set by render()) ──────────────────── */
  /*
    Col 1: left 0  / right 28  → 28px total
    Col 2: left 28 / right 28  → 56px total  (+ 1px visual line via background-image)
    Col 3: left 28 / right 0   → 28px total  (+ 1px visual line via background-image)
    The grid gives col 2 a 28px wider track, so all three have equal content width. The separator uses background-image (no layout impact).
  */
  .item.is-col-sep .body {
    padding-left: 1.6471rem;
    padding-right: 1.6471rem;
    background-image: linear-gradient(to right, var(--card-border) 1px, transparent 1px);
  }

  .item.is-col-end .body {
    padding-left: 1.6471rem;
    padding-right: 0;
  }

  .item.is-row-sep {
    border-top: 1px solid var(--card-border);
  }

  /* ── Body ───────────────────────────────────────────── */
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.4118rem 1.6471rem 1.6471rem 0;
  }

  /* ── Meta ───────────────────────────────────────────── */

  .date {
    font-size: 0.8235rem;
    font-weight: 400;
    color: var(--color-neutral-500);
  }

  /* ── Pagination ─────────────────────────────────────── */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.2353rem;
    padding: 1.6471rem 0 0.2353rem;
  }

  .page-btn {
    min-width: 2.1176rem;
    height: 2.1176rem;
    padding: 0 0.7059rem;
    border: 1px solid var(--card-border);
    border-radius: var(--radius-xs);
    background: white;
    color: var(--color-neutral-600);
    font-family: var(--font-body);
    font-size: 0.8235rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .page-btn[aria-label] {
    font-size: 1.0588rem;
    padding: 0 0.5882rem;
  }

  .page-btn:hover:not(:disabled) {
    border-color: var(--color-primary-300);
    color: var(--color-primary-700);
    background: color-mix(in oklch, var(--color-primary-50) 70%, white);
  }

  .page-btn.is-active {
    background: var(--color-primary-600);
    border-color: var(--color-primary-600);
    color: white;
    font-weight: 600;
  }

  .page-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* ── Responsive ─────────────────────────────────────── */
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .image { height: auto; aspect-ratio: 3 / 1; }
    .item.is-col-sep .body,
    .item.is-col-end .body { padding: 1.4118rem 0; background-image: none; }
    .body { padding: 1.4118rem 0; }
    .item { border-top: 1px solid var(--card-border); }
  }
</style>
