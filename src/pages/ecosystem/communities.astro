---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CtaFinal from '../../components/ui/CtaFinal.astro';
import { getCollection } from 'astro:content';
import numbersData from '../../data/numbers.yml';

const entries = await getCollection('communities');
const items = entries
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .map(e => ({ id: e.id, ...e.data }));

const gatewayEntries = await getCollection('gateways');
const gatewaysItems = gatewayEntries.map(e => ({ id: e.id, ...e.data }));

function formatUsers(count: number): string {
  if (count >= 1_000_000) {
    const v = count / 1_000_000;
    return `${Number.isInteger(v) ? v : v.toFixed(1)}M`;
  }
  if (count >= 1_000) {
    const v = count / 1_000;
    return `${Number.isInteger(v) ? v : v.toFixed(1)}k`;
  }
  return `${count}`;
}

const totalCommunities = items.length;
const totalGateways = gatewaysItems.length;
const researchersItem = (numbersData.items as Array<Record<string, string>>).find(i => i.source === 'communities');
const researchersValue = researchersItem?.value ?? '0';

const icons: Record<string, string> = {
  marine:         `<path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>`,
  climate:        `<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>`,
  life:           `<path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/>`,
  social:         `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  humanities:     `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`,
  physics:        `<circle cx="12" cy="12" r="1"/><path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5z"/><path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5z"/>`,
  earth:          `<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>`,
  astronomy:      `<circle cx="12" cy="12" r="2"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>`,
};

function linkArrow(url: string): string {
  return (url.startsWith('http') || url.startsWith('//'))
    ? `<line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>`
    : `<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>`;
}

const firstSlug: string = items[0]?.slug ?? '';
const communityIds = JSON.stringify(items.map((i: any) => i.slug));
---

<Layout title="Communities — AI4EOSC Ecosystem" ogImage="/og/communities.png">
  <PageHero
    theme="pink"
    breadcrumb="Communities"
    breadcrumbParent={{ label: 'Ecosystem' }}
    title="AI tools for every scientific domain"
    description="AI4EOSC brings research-grade AI to a growing number of scientific communities across Europe — from marine biology to climate science and beyond."
  >
    <div class="hero-stats">
      <div class="hstat"><span class="hstat-val">{totalCommunities}<em>+</em></span><span class="hstat-lbl">Active communities</span></div>
      <div class="hstat"><span class="hstat-val">{researchersValue}<em>+</em></span><span class="hstat-lbl">Researchers served</span></div>
      <div class="hstat"><span class="hstat-val">{totalGateways}<em>+</em></span><span class="hstat-lbl">Gateways deployed</span></div>
    </div>
  </PageHero>

  <!-- ── Communities catalogue ────────────────────────── -->
  <section class="p-section">
    <div class="section-label"><div class="container">All communities</div></div>
    <div class="container">
      <div class="section-card">
        <h2 class="sc-title">Research domains</h2>
        <p class="sc-sub">Select a community to see the AI tools available, related gateways and how to get access.</p>

        <div class="catalogue" x-data={`{
          active: '${firstSlug}',
          ids: ${communityIds},
          init() {
            this.$watch('active', v => history.replaceState(null, '', '#' + v));
            this.$nextTick(() => {
              const hash = window.location.hash.slice(1);
              if (hash && this.ids.includes(hash)) this.active = hash;
            });
          }
        }`}>

          <!-- Sidebar / tab strip -->
          <div class="cat-sidebar">
            {items.map((item: any) => (
              <button
                class="sidebar-item"
                x-bind:class={`{ 'is-active': active === '${item.slug}' }`}
                x-on:click={`active = '${item.slug}'`}
                type="button"
              >
                <span class="sc sc--lg" aria-hidden="true"></span>
                <span class="sc sc--md" aria-hidden="true"></span>
                <span class="sc sc--sm" aria-hidden="true"></span>
                <div class="si-inner">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="white" stroke-width="1.75" stroke-linecap="round"
                    stroke-linejoin="round" aria-hidden="true"
                    set:html={icons[item.iconId]} />
                  <span class="si-name">{item.title}</span>
                </div>
              </button>
            ))}
          </div>

          <!-- Detail panels -->
          <div class="cat-detail">
            {items.map((item: any) => (
              <div class="detail-panel" x-show={`active === '${item.slug}'`} x-cloak>
                <div class="detail-inner">

                  <!-- Left: content -->
                  <div class="pdl">
                    <div class="pdl-top">
                      {item.via && (
                        <a class="badge b-via" href={`/ecosystem/gateways${item.gatewaySlug ? '#' + item.gatewaySlug : ''}`}>
                          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                          via {item.via}
                        </a>
                      )}
                    </div>
                    <div class="title-row">
                      <span class="title-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.iconId]} />
                      </span>
                      <h3>{item.title}</h3>
                    </div>
                    <p class="pdl-tagline">{item.tagline}</p>
                    {item.description && <p class="pdl-desc">{item.description}</p>}

                    {item.tools && (
                      <>
                        <p class="feat-lbl">Available tools</p>
                        <ul class="feats">
                          {item.tools.map((t: string) => (
                            <li class="feat-chip">{t}</li>
                          ))}
                        </ul>
                      </>
                    )}
                  </div>

                  <!-- Right: stats + actions -->
                  <div class="pdr">
                    <div class="meta-block">
                      {item.users && (
                        <div class="meta-item">
                          <span class="meta-lbl">Researchers</span>
                          <span class="meta-val">{formatUsers(item.users)}+</span>
                        </div>
                      )}
                      {item.via && (
                        <div class="meta-item">
                          <span class="meta-lbl">Gateway</span>
                          <a class="meta-val meta-project-link" href={`/ecosystem/gateways${item.gatewaySlug ? '#' + item.gatewaySlug : ''}`}>
                            {item.via}
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={linkArrow(`/ecosystem/gateways`)} />
                          </a>
                        </div>
                      )}
                      {item.researchInfrastructures && item.researchInfrastructures.length > 0 && (
                        <div class="meta-item">
                          <span class="meta-lbl">Research infrastructures</span>
                          <div class="meta-ri-list">
                            {item.researchInfrastructures.map((ri: { name: string; link: string }) => (
                              <a class="meta-val meta-project-link" href={ri.link} target="_blank" rel="noopener">
                                {ri.name}
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={linkArrow(ri.link)} />
                              </a>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>

                    <div class="pdr-actions">
                      {item.viaUrl && (
                        <a class="btn-gray" href={item.viaUrl} target="_blank" rel="noopener">
                          Visit gateway
                        </a>
                      )}
                    </div>
                  </div>

                </div>
              </div>
            ))}
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ── How to join ────────────────────────────────────── -->
  <section class="p-section">
    <div class="section-label"><div class="container">How to join</div></div>
    <div class="container">
      <div class="section-card">
        <h2 class="sc-title">Bring AI4EOSC to your domain</h2>
        <p class="sc-sub">Whether you're a researcher looking for tools or an institution wanting to deploy a community gateway, here's how to get started.</p>
        <div class="how-grid">
          <div class="step-item">
            <div class="step-top">
              <div class="step-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              </div>
              <span class="step-num">01</span>
            </div>
            <h4>Find your domain</h4>
            <p>Browse the communities above to see if your scientific area is already covered and what AI tools are available for your research.</p>
            <a class="step-link" href="#top">Browse communities</a>
          </div>
          <div class="step-item">
            <div class="step-top">
              <div class="step-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              </div>
              <span class="step-num">02</span>
            </div>
            <h4>Access via a gateway</h4>
            <p>Each community has a dedicated gateway — a tailored instance of the platform with domain-specific models and workflows.</p>
            <a class="step-link" href="/ecosystem/gateways">Explore gateways</a>
          </div>
          <div class="step-item">
            <div class="step-top">
              <div class="step-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </div>
              <span class="step-num">03</span>
            </div>
            <h4>Deploy your own</h4>
            <p>If your domain isn't covered yet, get in touch. We can help you deploy a new community gateway on AI4EOSC infrastructure.</p>
            <a class="step-link" href="/support/contact">Contact the team</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaFinal
    theme="pink"
    title="Is your scientific domain missing?"
    description="If your research area isn't covered yet, we'd love to hear from you. We can help set up a dedicated community gateway on AI4EOSC."
    button={{ label: 'Get in touch', href: '/support/contact' }}
  />
</Layout>

<style>
  /* Theme tokens consumed by the shared catalogue styles in global.css */
  .catalogue {
    margin-top: 1.4118rem;
    --si-glow-a: rgba(192, 32, 96, 0.18);
    --si-glow-b: rgba(236, 93, 128, 0.12);
    --si-focus: rgba(236,93,128,0.5);
    --si-active-bg:
      radial-gradient(ellipse 60% 55% at 12% 12%, rgba(255,255,255,0.13) 0%, transparent 55%),
      radial-gradient(ellipse 55% 45% at 85% 88%, rgba(80,10,30,0.45) 0%, transparent 58%),
      var(--gradient-pink);
    --si-active-shadow: 0 4px 24px rgba(192, 32, 96, 0.3);
    --si-sc-shadow: 0 0 0 1px rgba(255,255,255,0.08), 0 0 20px rgba(192,32,96,0.12);
    --si-sc-active-shadow: 0 0 0 1px rgba(255,255,255,0.45), 0 0 30px rgba(236,93,128,0.65), 0 0 70px rgba(192,32,96,0.35);
    --pdr-glow-a: rgba(192, 32, 96, 0.14);
    --pdr-glow-b: rgba(236, 93, 128, 0.08);
  }

  .detail-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14.1176rem;
    min-height: 20rem;
    align-items: stretch;
  }

  /* ── Left: content ──────────────────────────────────── */

  .pdl-top { margin-bottom: 0.8235rem; min-height: 1.2941rem; }

  .b-via {
    display: inline-flex; align-items: center; gap: 0.2941rem;
    color: var(--color-primary-700);
    background: var(--color-primary-50);
    border: 0.5px solid var(--color-primary-200);
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .b-via:hover {
    background: var(--color-primary-100);
    border-color: var(--color-primary-300);
  }

  .title-row {
    display: flex; align-items: center; gap: 0.5882rem; margin: 0 0 0.5882rem;
  }

  h3 {
    font-family: var(--font-headings);
    font-size: 1.6471rem; font-weight: 600; line-height: 1.15;
    color: var(--color-neutral-900); margin: 0;
  }

  .title-icon {
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    color: var(--color-secondary-600);
  }

  .pdl-tagline {
    font-size: 0.9412rem; font-weight: 500; line-height: 1.5;
    color: var(--color-neutral-700); margin: 0 0 0.8235rem;
    text-align: justify;
  }

  .pdl-desc {
    font-size: 0.9412rem; line-height: 1.7;
    color: var(--color-neutral-500); margin: 0 0 1.4118rem;
    text-align: justify;
  }

  .feats {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: 0.3529rem;
  }

  .feat-chip {
    font-size: 0.9412rem; font-weight: 500;
    color: var(--color-secondary-700);
    background: rgba(201,75,114,0.07);
    border: 0.5px solid rgba(201,75,114,0.2);
    border-radius: var(--radius-pill); padding: 0.2353rem 0.8235rem;
  }

  /* ── Right: stats + actions ─────────────────────────── */

  .meta-block { display: flex; flex-direction: column; gap: 0.9412rem; }

  .meta-item { display: flex; flex-direction: column; gap: 0.2353rem; }
  .meta-project-link {
    display: inline-flex; align-items: center; gap: 0.2353rem;
    text-decoration: none; transition: color 0.15s;
  }
  .meta-project-link:hover { color: white; }

  .meta-ri-list { display: flex; flex-direction: column; gap: 0.3529rem; }

  /* Buttons */
  .pdr-actions { display: flex; flex-direction: column; gap: 0.3529rem; margin-top: auto; }

  .btn-gray { border: none; /* override global border for this context */
  }

  /* ── How to join ────────────────────────────────────── */
  .how-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 1.4118rem;
    border-top: 1px solid var(--card-border);
    --step-50: var(--color-secondary-50);
    --step-100: var(--color-secondary-100);
    --step-400: var(--color-secondary-400);
    --step-600: var(--color-secondary-600);
    --step-arrow: '\2192\FE0E';
    --step-arrow-size: 0.7647rem;
  }

  /* ── Responsive ─────────────────────────────────────── */
  @media (max-width: 860px) {
    .how-grid { grid-template-columns: 1fr; border-top: none; }
  }

  @media (max-width: 640px) {
    .detail-inner { grid-template-columns: 1fr; min-height: unset; }
  }
</style>
