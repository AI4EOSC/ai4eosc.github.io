---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CtaFinal from '../../components/ui/CtaFinal.astro';
import data from '../../data/faq.yml';
---

<Layout
  title="FAQ — AI4EOSC Initiative"
  description="Answers to common questions about the AI4EOSC platform, access, the model catalogue, and the ecosystem of projects and gateways."
  ogImage="/og/faq.png"
>
  <PageHero
    theme="pink"
    breadcrumb="FAQ"
    breadcrumbParent={{ label: 'Support' }}
    title="Frequently asked questions"
    description="Answers to the most common questions about the AI4EOSC platform, access, the ecosystem and the technical stack."
  />

  <section class="p-section has-top">
    <div class="container">
      <div class="faq-wrap">

        {data.categories.map((cat: any) => (
          <div class="faq-row" id={cat.id}>

            <!-- Sticky category label -->
            <div class="cat-col">
              <div class="cat-sticky">
                <span class="cat-num">{String(data.categories.indexOf(cat) + 1).padStart(2, '0')}</span>
                <h2 class="cat-title">{cat.label}</h2>
                <span class="cat-count">{cat.items.length} questions</span>
              </div>
            </div>

            <!-- Questions -->
            <div class="qa-col">
              {cat.items.map((item: any, i: number) => (
                <div class={`qa-item${i === cat.items.length - 1 ? ' is-last' : ''}`}>
                  <p class="q-text">{item.question}</p>
                  <p class="qa-a">{item.answer}</p>
                </div>
              ))}
            </div>

          </div>
        ))}

      </div>
    </div>
  </section>

  <CtaFinal
    theme="pink"
    title="Still have questions?"
    description="If you didn't find what you were looking for, our team is happy to help. Reach out directly and we'll get back to you."
    button={{ label: 'Contact the team', href: '/support/contact' }}
  />
</Layout>

<style>
  .p-section.has-top { padding-top: 1.6471rem; }
  @media (max-width: 640px) { .p-section.has-top { padding-top: 2.3529rem; } }

  /* ── Wrapper ─────────────────────────────────────────── */
  .faq-wrap {
    background: var(--card-bg);
    border: 0.5px solid var(--card-border);
    border-radius: var(--radius-lg);
  }

  /* ── Row: one per category ───────────────────────────── */
  .faq-row {
    display: grid;
    grid-template-columns: 15.2941rem minmax(0, 1fr);
    border-bottom: 0.5px solid var(--card-border);
  }

  .faq-row:last-child { border-bottom: none; }

  /* ── Category column (sticky title) ─────────────────── */
  .cat-col {
    border-right: 0.5px solid var(--card-border);
    padding: 2.3529rem 1.8824rem;
  }

  .cat-sticky {
    position: sticky;
    top: calc(var(--nav-offset) + 0.941rem);
    display: flex;
    flex-direction: column;
    gap: 0.4706rem;
  }

  .cat-num {
    font-size: 1.0588rem; font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-secondary-400);
  }

  .cat-title {
    font-family: var(--font-headings);
    font-size: 1.6471rem; font-weight: 500;
    line-height: 1.1;
    color: var(--color-neutral-900);
    margin: 0;
  }

  .cat-count {
    font-size: 0.8824rem; color: var(--color-neutral-400);
    margin-top: 0.2353rem;
  }

  /* ── Q&A column ──────────────────────────────────────── */
  .qa-col {
    padding: 0;
  }

  /* ── Individual Q&A item ─────────────────────────────── */
  .qa-item {
    padding: 1.8824rem 2.3529rem;
    border-bottom: 0.5px solid var(--card-border);
  }

  .qa-item.is-last { border-bottom: none; }

  .q-text {
    font-size: 1rem; font-weight: 600;
    color: var(--color-neutral-900);
    line-height: 1.4;
    margin: 0 0 0.8235rem;
  }

  .q-text::before {
    content: '';
    display: inline-block;
    width: 0.3529rem; height: 0.3529rem;
    border-radius: 50%;
    background: var(--color-secondary-400);
    margin-right: 0.5882rem;
    vertical-align: middle;
    margin-bottom: 0.1176rem;
    flex-shrink: 0;
  }

  .qa-a {
    font-size: 0.9412rem; line-height: 1.8;
    color: var(--color-neutral-500);
    margin: 0;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 860px) {
    .faq-row {
      grid-template-columns: 1fr;
    }
    .cat-col {
      border-right: none;
      border-bottom: 0.5px solid var(--card-border);
      padding: 1.6471rem 1.6471rem 1.2941rem;
    }
    .cat-sticky {
      position: static;
      flex-direction: row;
      align-items: baseline;
      gap: 0.7059rem;
      flex-wrap: wrap;
    }
    .cat-title { font-size: 1.1765rem; }
    .cat-num, .cat-count { display: none; }
    .qa-item { padding: 1.4118rem 1.6471rem; }
  }

  @media (max-width: 640px) {
    .qa-item { padding: 1.1765rem; }
    .qa-a { padding-left: 0; }
    .q-text { font-size: 0.8824rem; }
  }
</style>
