---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import CtaFinal from '../components/ui/CtaFinal.astro';
import OpenSourceBanner from '../components/sections/OpenSourceBanner.astro';
import '../styles/mockup.css';
import { getCollection } from 'astro:content';
const productEntries = await getCollection('products');
const data = { items: productEntries.sort((a, b) => a.data.order - b.data.order).map(e => ({ id: e.id, ...e.data })) };

const statusSlug: Record<string, string> = {
  'Available':   'available',
  'Preview':     'preview',
  'Coming soon': 'soon',
};

const productIcons: Record<string, string> = {
  platform: `<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>`,
  llm:      `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>`,
  agents:   `<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/>`,
  inference:`<path d="M13 2L4.09 12.97a1 1 0 0 0 .77 1.63H11l-1 7.4 8.91-10.97a1 1 0 0 0-.77-1.63H12z"/>`,
};

// Preview chrome falls back to the visit URL host when previewUrl is absent
const chromeUrl = (item: any): string =>
  item.previewUrl ?? new URL(item.visitHref).hostname;

const firstId: string = data.items[0]?.slug ?? 'platform';
const productIds = JSON.stringify(data.items.map((i: any) => i.slug));
const alpineProductItems = JSON.stringify(data.items.map((i: any) => ({ id: i.slug, status: i.status })));
const productStatuses = ['All', ...Array.from(new Set(data.items.map((i: any) => i.status as string))).sort()];
---

<Layout title="Products — AI4EOSC Initiative" ogImage="/og/products.png">
  <PageHero
    title="AI4EOSC Software Products"
    description="Open infrastructure and services for AI in the European Open Science Cloud. Built for researchers, by researchers."
    breadcrumb="Products"
    theme="black"
  />

  <!-- ── Catalogue ───────────────────────────────────────── -->
  <section class="p-section">
    <div class="section-label"><div class="container">All products</div></div>
    <div class="container">
      <div class="section-card">
        <h2 class="sc-title">Software catalogue</h2>
        <p class="sc-sub">Production-ready tools for the European Open Science Cloud. Select a product to explore features and links.</p>

        <!--
          Desktop:  sidebar (column, 200px) | detail panel (flex-1)
          Mobile:   sidebar becomes horizontal scroll row, panel full-width below
        -->
        <div x-data={`{
          active: '${firstId}',
          filter: 'All',
          ids: ${productIds},
          items: ${alpineProductItems},
          init() {
            this.$watch('active', v => history.replaceState(null, '', '#' + v));
            this.$nextTick(() => {
              const hash = window.location.hash.slice(1);
              if (hash && this.ids.includes(hash)) this.active = hash;
            });
          },
          setFilter(f) {
            this.filter = f;
            const vis = this.items.filter(i => f === 'All' || i.status === f);
            if (vis.length && !vis.some(i => i.id === this.active)) this.active = vis[0].id;
          }
        }`}>

          <!-- Status filter -->
          <div class="filter-columns">
            <div class="filter-col">
              <span class="filter-col-label">Status</span>
              <div class="filters">
                {productStatuses.map(s => (
                  <button
                    class="filter-btn"
                    x-bind:class={`{ 'is-active': filter === '${s}' }`}
                    x-on:click={`setFilter('${s}')`}
                    type="button"
                  >{s}</button>
                ))}
              </div>
            </div>
          </div>

          <div class="catalogue">

          <!-- Sidebar / tab strip -->
          <div class="cat-sidebar">
            {data.items.map((item: any) => (
              <button
                class={`sidebar-item screen-${item.theme}`}
                x-show={`filter === 'All' || filter === '${item.status}'`}
                x-bind:class={`{ 'is-active': active === '${item.slug}' }`}
                x-on:click={`active = '${item.slug}'`}
                type="button"
              >
                <span class="sc sc--lg" aria-hidden="true"></span>
                <span class="sc sc--md" aria-hidden="true"></span>
                <span class="sc sc--sm" aria-hidden="true"></span>
                <div class="si-inner">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="white" stroke-width="1.75" stroke-linecap="round"
                    stroke-linejoin="round" aria-hidden="true"
                    set:html={productIcons[item.iconId]} />
                  <span class="si-name">{item.title}</span>
                </div>
              </button>
            ))}
          </div>

          <!-- Detail panels -->
          <div class="cat-detail">
            {data.items.map((item: any) => (
              <div class="detail-panel" x-show={`active === '${item.slug}'`} x-cloak>
                <div class="detail-inner">

                  <!-- Body (left on desktop) -->
                  <div class="detail-body">
                    <div class="prod-top">
                      <span class="category">{item.category}</span>
                      <span class={`status status-${statusSlug[item.status] ?? 'soon'}`}>{item.status}</span>
                    </div>
                    <h3>{item.title}</h3>
                    <p class="tagline">{item.tagline}</p>
                    <p class="desc">{item.description}</p>
                    <p class="feat-lbl">Features</p>
                    <ul class="feats">
                      {item.features.map((f: string) => (
                        <li class="feat-chip">{f}</li>
                      ))}
                    </ul>
                  </div>

                  <!-- Right column: preview + actions -->
                  <div class="detail-right">
                  <div class="detail-render mockup">
                    <div class="chrome">
                      <span class="dot"></span>
                      <span class="dot"></span>
                      <span class="dot"></span>
                      <span class="url">{chromeUrl(item)}</span>
                    </div>
                    <div class={`render-body${item.slug === 'llm' ? ' render-center' : ''}`}>

                      {item.slug === 'platform' && (
                        <>
                          <div class="stat-row">
                            <div class="stat"><span class="stat-n">247</span><span class="stat-l">Models</span></div>
                            <div class="stat"><span class="stat-n">1.2k</span><span class="stat-l">Users</span></div>
                            <div class="stat"><span class="stat-n">12</span><span class="stat-l">Gateways</span></div>
                          </div>
                          <div class="divider"></div>
                          <div class="job">
                            <div class="job-row"><span class="job-name">Training #142</span><span class="job-pct">68%</span></div>
                            <div class="track"><div class="fill" style="width:68%"></div></div>
                          </div>
                          <div class="job">
                            <div class="job-row"><span class="job-name">Serving #89</span><span class="job-pct active">Active</span></div>
                            <div class="track"><div class="fill" style="width:100%;opacity:0.45"></div></div>
                          </div>
                          <div class="divider"></div>
                          <div class="model-list">
                            <div class="model-row">
                              <span class="model-led led-on"></span>
                              <span class="model-name">ResNet-50-marine</span>
                              <span class="model-badge">Serving</span>
                            </div>
                            <div class="model-row">
                              <span class="model-led led-train"></span>
                              <span class="model-name">BERT-multilingual</span>
                              <span class="model-badge badge-train">Training</span>
                            </div>
                            <div class="model-row">
                              <span class="model-led led-off"></span>
                              <span class="model-name">YOLOv8-climate</span>
                              <span class="model-badge badge-off">Queued</span>
                            </div>
                          </div>
                        </>
                      )}

                      {item.slug === 'llm' && (
                        <>
                          <div class="llm-badges">
                            <span class="badge-pill">Mixtral-8x7B</span>
                            <span class="badge-pill muted">EU-hosted</span>
                          </div>
                          <div class="chat-gap"></div>
                          <div class="chat-row chat-row--end">
                            <div class="bubble bubble-u">Summarise this research paper…</div>
                            <div class="av av-u">U</div>
                          </div>
                          <div class="chat-row">
                            <div class="av av-ai">AI</div>
                            <div class="bubble bubble-ai">The paper presents a novel approach to federated learning with privacy guarantees…</div>
                          </div>
                          <div class="chat-row chat-row--end">
                            <div class="bubble bubble-u">What are the key limitations?</div>
                            <div class="av av-u">U</div>
                          </div>
                          <div class="chat-row">
                            <div class="av av-ai">AI</div>
                            <div class="bubble bubble-typing">
                              <span class="tydot"></span><span class="tydot"></span><span class="tydot"></span>
                            </div>
                          </div>
                        </>
                      )}

                      {item.slug === 'agents' && (
                        <>
                          <div class="pipeline">
                            <div class="pipe-step">
                              <div class="node node--done">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                              </div>
                              <span class="pipe-lbl">Retrieve</span>
                            </div>
                            <div class="pipe-line pipe-line--done"></div>
                            <div class="pipe-step">
                              <div class="node node--active">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3"/></svg>
                              </div>
                              <span class="pipe-lbl">Process</span>
                            </div>
                            <div class="pipe-line"></div>
                            <div class="pipe-step">
                              <div class="node node--pending">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                              </div>
                              <span class="pipe-lbl">Deliver</span>
                            </div>
                          </div>
                          <div class="divider"></div>
                          <div class="conn-title">Connected services</div>
                          <div class="conn-grid">
                            <div class="conn-chip chip-on">
                              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                              EOSC Search
                            </div>
                            <div class="conn-chip chip-active">
                              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3"/></svg>
                              LLM API
                            </div>
                            <div class="conn-chip chip-on">
                              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                              Nextcloud
                            </div>
                            <div class="conn-chip chip-on">
                              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                              OSCAR
                            </div>
                          </div>
                          <div class="ag-status">
                            <span class="ag-dot"></span>
                            Running step 2 of 3
                            <span class="step-dots">
                              <span class="sdot sdot-done"></span>
                              <span class="sdot sdot-active"></span>
                              <span class="sdot sdot-pending"></span>
                            </span>
                          </div>
                        </>
                      )}

                      {item.slug === 'inference' && (
                        <>
                          <div class="inf-fn">
                            <span class="inf-trigger">
                              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/></svg>
                              Event
                            </span>
                            <span class="inf-arrow">→</span>
                            <span class="inf-fn-name">plant-classifier</span>
                            <span class="inf-fn-badge">async</span>
                          </div>
                          <div class="divider"></div>
                          <div class="conn-title">Auto-scaled replicas</div>
                          <div class="inf-pods">
                            <span class="pod pod-on"></span>
                            <span class="pod pod-on"></span>
                            <span class="pod pod-on"></span>
                            <span class="pod pod-boot"></span>
                            <span class="pod pod-idle"></span>
                            <span class="pod pod-idle"></span>
                          </div>
                          <div class="inf-metrics">
                            <div class="inf-metric"><span class="stat-n">1.4k</span><span class="stat-l">Invocations</span></div>
                            <div class="inf-metric"><span class="stat-n">86ms</span><span class="stat-l">p95 latency</span></div>
                            <div class="inf-metric"><span class="stat-n">0</span><span class="stat-l">Idle cost</span></div>
                          </div>
                          <div class="divider"></div>
                          <div class="model-list">
                            <div class="model-row">
                              <span class="model-led led-on"></span>
                              <span class="model-name">MinIO → inference → output</span>
                              <span class="model-badge">Done</span>
                            </div>
                            <div class="model-row">
                              <span class="model-led led-train"></span>
                              <span class="model-name">Batch job #37</span>
                              <span class="model-badge badge-train">Running</span>
                            </div>
                          </div>
                        </>
                      )}

                    </div>
                  </div>
                  <div class="prod-actions">
                    <a href={item.visitHref} target="_blank" rel="noopener" class="btn-visit">{item.visitLabel}</a>
                    {item.docsHref && (
                      <a href={item.docsHref} target="_blank" rel="noopener" class="btn-docs">Documentation</a>
                    )}
                  </div>
                  </div>

                </div>
              </div>
            ))}
          </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Open source banner ────────────────────────────── -->
  <OpenSourceBanner />

  <!-- ── Tech stack ─────────────────────────────────────── -->
  <section class="p-section">
    <div class="section-label"><div class="container">Under the hood</div></div>
    <div class="container">
      <div class="section-card">
        <h2 class="sc-title">Built on open standards</h2>
        <p class="sc-sub">The entire technology stack is open-source, interoperable, and built for the European research community.</p>
        <div class="tech-list">
          <div class="tech-row">
            <div class="tech-item">
              <div class="tech-item-header">
                <div class="tech-icon-wrap" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                </div>
                <span class="tech-name">DEEPaaS API</span>
              </div>
              <p class="tech-desc">Standardised REST API for exposing AI models as services, regardless of framework.</p>
            </div>
            <div class="tech-item">
              <div class="tech-item-header">
                <div class="tech-icon-wrap" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
                </div>
                <span class="tech-name">OSCAR</span>
              </div>
              <p class="tech-desc">Serverless computing framework for data-driven AI inference on hybrid cloud.</p>
            </div>
          </div>
          <div class="tech-row">
            <div class="tech-item">
              <div class="tech-item-header">
                <div class="tech-icon-wrap" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <span class="tech-name">EOSC AAI</span>
              </div>
              <p class="tech-desc">Federated authentication and authorisation via the EOSC identity provider.</p>
            </div>
            <div class="tech-item">
              <div class="tech-item-header">
                <div class="tech-icon-wrap" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/></svg>
                </div>
                <span class="tech-name">Nextcloud</span>
              </div>
              <p class="tech-desc">Storage for datasets and model artefacts that can be accessed from the development environment.</p>
            </div>
          </div>
          <div class="tech-row">
            <div class="tech-item">
              <div class="tech-item-header">
                <div class="tech-icon-wrap" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                </div>
                <span class="tech-name">MLflow</span>
              </div>
              <p class="tech-desc">Experiment tracking and model registry integrated into the training pipeline.</p>
            </div>
            <div class="tech-item">
              <div class="tech-item-header">
                <div class="tech-icon-wrap" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                </div>
                <span class="tech-name">Nomad</span>
              </div>
              <p class="tech-desc">Containerised deployment on Nomad for reproducibility and scalability.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Get started ────────────────────────────────────── -->
  <section class="p-section">
    <div class="section-label"><div class="container">Get started</div></div>
    <div class="container">
      <div class="section-card">
        <h2 class="sc-title">Three steps to get started</h2>
        <p class="sc-sub">From account creation to deploying your first model — everything you need to begin.</p>
      <div class="steps-grid">
        <div class="step-item">
          <div class="step-top">
            <div class="step-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <span class="step-num">01</span>
          </div>
          <h4>Login with EduGain</h4>
          <p>Sign up via using your institutional credentials. Access is free for demonstration for researchers and developers affiliated with an EU member research organisations.</p>
          <a class="step-link" href="https://dashboard.cloud.ai4eosc.eu" target="_blank" rel="noopener">Go to AI4EOSC dashboard</a>
        </div>
        <div class="step-item">
          <div class="step-top">
            <div class="step-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </div>
            <span class="step-num">02</span>
          </div>
          <h4>Train and deploy</h4>
          <p>Browse over available models in the AI catalogue, re-train an existing one or deploy your own module using the advanced AI tools available.</p>
          <a class="step-link" href="https://docs.ai4eosc.eu" target="_blank" rel="noopener">Read the docs</a>
        </div>
        <div class="step-item">
          <div class="step-top">
            <div class="step-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            </div>
            <span class="step-num">03</span>
          </div>
          <h4>Share and server</h4>
          <p>Publish your model making it reusable by the European research community. Serve it at scale using serverless computing or dedicated resources.</p>
          <a class="step-link" href="https://docs.ai4eosc.eu/en/latest/howtos/deploy/index.html" target="_blank" rel="noopener">Deployment guide</a>
        </div>
      </div>
      </div>
    </div>
  </section>

  <CtaFinal
    title="Ready to join"
    description="Join hundreds of researchers already using AI4EOSC to accelerate their AI workflows and to contribute to the EOSC."
    button={{ label: "Get started ↗︎", href: "https://dashboard.cloud.ai4eosc.eu" }}
    theme="black"
  />
</Layout>

<style>
  /* Theme tokens consumed by the shared catalogue styles in global.css */
  .catalogue {
    --si-glow-a: rgba(0, 135, 146, 0.14);
    --si-glow-b: rgba(236, 93, 128, 0.10);
    --si-focus: rgba(255,255,255,0.4);
    --si-active-bg:
      radial-gradient(ellipse 60% 55% at 10% 50%, rgba(0,200,215,0.22) 0%, transparent 55%),
      var(--gradient-primary);
    --si-active-shadow: 0 4px 24px rgba(0,135,146,0.3);
    --si-sc-shadow: 0 0 0 1px rgba(255,255,255,0.08), 0 0 20px rgba(255,255,255,0.04);
    --si-sc-active-shadow: 0 0 0 1px rgba(255,255,255,0.45), 0 0 30px rgba(0,200,215,0.6), 0 0 70px rgba(0,135,146,0.35);
  }

  /* ── Detail panel — card gris ─────────────────────── */
  .detail-panel {
    background: var(--page-bg);
    padding: 1.6471rem;
    overflow: visible; /* global .detail-panel clips */
  }

  /* Texto izquierda (col 1) · preview + actions derecha (col 2) */
  .detail-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: 0.9412rem 1.6471rem;
