---
interface Props {
  title: string;
  subtitle?: string;
  actionLabel?: string;
  actionHref?: string;
}

const { title, subtitle, actionLabel, actionHref } = Astro.props;
---

<div class="section-header">
  <div>
    <h2>{title}</h2>
    {subtitle && <p>{subtitle}</p>}
  </div>
  {actionLabel && actionHref && (
    <a class="button-pill dark" href={actionHref}>{actionLabel}</a>
  )}
</div>

<style>
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.1765rem;
    margin-bottom: 0.7059rem;
  }

  h2 {
    margin: 0;
    font-size: 1.5294rem;
    font-weight: 650;
    color: var(--color-neutral-900);
  }

  p {
    margin: 0.4706rem 0 0;
    font-size: 0.9412rem;
    line-height: 1.6;
    color: var(--color-neutral-500);
    max-width: 27.06rem;
  }

  .button-pill.dark::after { content: "\2192\FE0E"; margin-left: 0.2353rem; }

  @media (max-width: 860px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
