---
import { getCollection } from 'astro:content';
import SectionHeader from '../ui/SectionHeader.astro';
import '../../styles/story-card.css';
import { eventTime } from '../../lib/eventTime';

const stories = await getCollection('stories');
const sortedStories = stories
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3 + stories.filter(s => s.data.type === 'Event').length); // upcoming events are moved out client-side, then trimmed to 3
---

<section id="upcoming-events" hidden>
  <div class="section-label">
    <div class="container">Upcoming events</div>
  </div>
  <div class="container">
    <div class="section-card">
      <SectionHeader
        title="What's next"
        subtitle="Webinars and events from across the AI4EOSC ecosystem."
        actionLabel="All events"
        actionHref="/stories"
      />
      <div class="grid" id="upcoming-grid"></div>
    </div>
  </div>
</section>

<section>
  <div class="section-label">
    <div class="container">Latest stories</div>
  </div>
  <div class="container">
    <div class="section-card">
      <SectionHeader
        title="From the initiative"
        subtitle="News, case studies and research highlights from across the AI4EOSC ecosystem."
        actionLabel="All stories"
        actionHref="/stories"
      />
      <div class="grid" id="latest-grid">
        {sortedStories.map((story, i) => (
          <a
            href={story.data.externalUrl ?? `/stories/${story.id}`}
            class="item story-card reveal has-image"
            data-event-date={story.data.type === 'Event' ? story.data.date.toISOString().slice(0, 10) : undefined}
            data-event-start={story.data.eventStart?.toISOString()}
            data-event-end={story.data.eventEnd?.toISOString()}
            style={`transition-delay: ${i * 80}ms`}
            {...(story.data.externalUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <div class="image">
              {story.data.image
                ? <img src={story.data.image} alt="" loading="lazy" />
                : <div class="placeholder" aria-hidden="true">
                    <svg class="placeholder-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.2"/>
                      <path d="M7 8h10M7 12h10M7 16h6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                  </div>
              }
            </div>
            <div class="body">
              <div class="meta">
                <span class="tag">{story.data.type}</span>
                <span class="dot" aria-hidden="true"></span>
                <span class="date">
                  {story.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                </span>
                {eventTime(story.data) && (<>
                  <span class="dot" aria-hidden="true"></span>
                  <span class="date">{eventTime(story.data)}</span>
                </>)}
                {story.data.type === 'Event' && <span class="story-status" hidden></span>}
              </div>
              <h4>{story.data.title}</h4>
              <p>{story.data.excerpt}</p>
              <span class="read-link" data-event-action={story.data.type === 'Event' ? '' : undefined}>{story.data.externalUrl ? 'View on external site' : 'Read story'}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { placeUpcoming } from '../../lib/eventStatus';

  // page-load fires on every client-side navigation, a plain top-level call would only run on the first one
  document.addEventListener('astro:page-load', () => placeUpcoming(document.getElementById('latest-grid'), {
    block: document.getElementById('upcoming-events'),
    grid: document.getElementById('upcoming-grid'),
    keep: 3,
  }));
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: 1.4118rem;
    border-top: 1px solid var(--card-border);
  }

  /* Image: full-width bleed, no radius, flush to top */
  .image {
    width: 100%;
    aspect-ratio: 3 / 1;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--card-border);
    background: #1d3238;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(0, 135, 146, 0.2) 1px, transparent 1px);
    background-size: 1.1765rem 1.1765rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Body carries the horizontal padding */
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.4118rem 1.8824rem 1.6471rem 0;
  }

  .item + .item .body { padding-left: 1.8235rem; border-left: 1px solid var(--card-border); }
  .item:last-child .body { padding-right: 0; }

  .date {
    font-size: 0.8235rem;
    color: var(--color-neutral-500);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
      border-top: none;
    }

    .item {
      border-right: none;
      border-top: 1px solid var(--card-border);
    }

    .item + .item .body { border-left: none; }

    .body { padding: 1.4118rem 0 1.4118rem 0 !important; }
  }
</style>
